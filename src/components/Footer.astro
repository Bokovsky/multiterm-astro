---
import siteConfig from '~/site.config'
import IconNotByAI from '~/icons/notbyai.svg'
import IconByNcNd from '~/icons/by-nc-nd.svg'
---

<footer
  class="mt-auto pt-9 md:pt-11 grow-0 flex flex-col gap-6 items-center justify-between max-w-full text-foreground/80"
>
  <div class="flex flex-col md:flex-row flex-wrap flex-1 items-center justify-center">
    <span class="my-1">
      {siteConfig.author} © 2025-PRESENT
    </span>
    <span class="mx-5 hidden md:block"> :: </span>
    <span class="my-1">
      Powered by <a
        class="underline"
        target="_blank"
        rel="noopener noreferrer"
        href="https://astro.build">Astro</a
      >
      & <a
        class="underline"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/stelcodes/multiterm-astro">MultiTerm</a
      >
    </span>
  </div>
  <div class="flex items-center justify-center gap-4 h-7">
    <a
      href="https://notbyai.fyi"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center text-foreground/30 hover:text-foreground/50 transition-colors"
    >
      <IconNotByAI class="h-6 w-auto" />
    </a>
    <a
      href="https://creativecommons.org/licenses/by-nc-nd"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center text-foreground/30 hover:text-foreground/50 transition-colors"
    >
      <IconByNcNd class="h-6 w-auto" />
    </a>
  </div>
</footer>
