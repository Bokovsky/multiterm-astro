---
import type { CollectionEntry } from 'astro:content'
import { tagSlug } from '~/utils/collation'

interface Props {
  post: CollectionEntry<'posts'>
  index: number
}

const { post, index } = Astro.props
const tags = post.data.tags || []
const series = post.data.series
const formattedDate = post.data.published.toISOString().split('T')[0]
const staggerDelay = index * 60
---

<div
  class="timeline-item group relative pl-6 pb-6 last:pb-0"
  style={`--delay: ${staggerDelay}ms`}
>
  <div
    class="timeline-dot absolute left-0 top-2 -translate-x-1/2 z-10 size-3 rounded-full bg-background border-2 border-accent/40 group-hover:border-accent group-hover:scale-125 transition-all duration-250 ease-out"
  ></div>
  <div class="mb-1.5">
    <span class="text-xs tracking-wide text-foreground/30">{formattedDate}</span>
  </div>
  <h3 class="mb-1.5">
    <a
      href={`/posts/${post.id}`}
      class="text-base text-heading font-semibold relative inline-block after:absolute after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-accent group-hover:after:w-full after:transition-all after:duration-300"
    >
      # {post.data.title}
    </a>
  </h3>
  <div
    class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs opacity-0 group-hover:opacity-100 transition-opacity duration-200"
  >
    {
      series && (
        <a
          href={`/series/${tagSlug(series)}`}
          class="rounded-2xl py-px px-2.5 bg-foreground/5 hover:bg-foreground/10 border-1 border-foreground/10 hover:border-accent/30 transition-all duration-200"
        >
          {series}
        </a>
      )
    }
    {tags.map((tag) => (
      <a
        href={`/tags/${tagSlug(tag)}`}
        class="text-foreground/60 hover:text-accent transition-colors duration-200"
      >
        {tag}
      </a>
    ))}
  </div>
</div>

<style is:global>
  .timeline-item {
    animation: timeline-reveal 400ms ease-out both;
    animation-delay: var(--delay, 0ms);
  }
  .timeline-item::after {
    content: '';
    position: absolute;
    left: 0;
    transform: translateX(-50%);
    top: 0.875rem;
    bottom: 0;
    width: 1.5px;
    background: color-mix(in oklab, var(--theme-accent) 12%, transparent);
    transition: background 0.3s;
  }
  .timeline-item:hover::after {
    background: color-mix(in oklab, var(--theme-accent) 25%, transparent);
  }
  .timeline-dot {
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--theme-accent) 30%, transparent);
    transition: transform 0.25s ease-out, background 0.25s ease-out, box-shadow 0.3s ease-out;
  }
  .timeline-dot:hover,
  .group:hover .timeline-dot {
    box-shadow: 0 0 10px 2px color-mix(in oklab, var(--theme-accent) 35%, transparent);
  }
  @keyframes timeline-reveal {
    from {
      opacity: 0;
      transform: translateX(-4px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-item {
      animation: none;
    }
    .timeline-dot {
      transition: none;
    }
  }
</style>
