---
import { dateString, tagSlug } from '~/utils'
import ExternalLinkCard from '~/components/ExternalLinkCard.astro'
import MusicCard from '~/components/MusicCard.astro'
import MarkdownIt from 'markdown-it'
import { fetchMusicMetadata } from '~/music-metadata'
import type { CollectionEntry } from 'astro:content'

interface Props {
  memo: CollectionEntry<'memos'>
}

const { memo } = Astro.props
const formattedDate = dateString(memo.data.published)
const tags = memo.data.tags || []
const externalUrl = memo.data.externalUrl
const externalTitle = memo.data.externalTitle
const musicUrl = memo.data.musicUrl
const musicMeta = musicUrl && !memo.data.musicTitle
  ? await fetchMusicMetadata(musicUrl)
  : null
const musicTitle = memo.data.musicTitle || musicMeta?.title
const musicArtist = memo.data.musicArtist || musicMeta?.artist
const musicArtwork = musicMeta?.artworkUrl

interface ContentSegment {
  type: 'text' | 'images'
  html?: string
  images?: string[]
}

function parseAndRenderSegments(body: string): ContentSegment[] {
  const segments: ContentSegment[] = []
  const lines = body.split('\n')
  let currentText: string[] = []
  let currentImages: string[] = []
  const md = new MarkdownIt({ html: true, breaks: true })

  function flushText() {
    if (currentText.length > 0) {
      const text = currentText.join('\n').trim()
      if (text) segments.push({ type: 'text', html: md.render(text) })
      currentText = []
    }
  }
  function flushImages() {
    if (currentImages.length > 0) {
      segments.push({ type: 'images', images: [...currentImages] })
      currentImages = []
    }
  }

  const imgRegex = /^!\[.*?\]\(([^)]+)\)\s*$/

  for (const line of lines) {
    const trimmed = line.trim()
    const match = imgRegex.exec(trimmed)
    if (match) {
      flushText()
      currentImages.push(match[1])
    } else if (trimmed !== '') {
      flushImages()
      currentText.push(line)
    }
    // empty lines: don't break image groups
  }
  flushImages()
  flushText()

  return segments
}

const segments = memo.body ? parseAndRenderSegments(memo.body) : []
const hasImages = segments.some((s) => s.type === 'images')
---

<article
  class="memo-card relative w-full p-4 bg-foreground/[0.02]"
>
  {
    segments.length > 0 && (
      <div class="memo-content prose">
        {
          segments.map((seg) =>
            seg.type === 'text' ? (
              <Fragment set:html={seg.html || ''} />
            ) : (
              <div
                class:list={[
                  'memo-gallery not-prose grid gap-[3px]',
                  seg.images!.length === 1
                    ? 'grid-cols-1'
                    : seg.images!.length === 2
                      ? 'grid-cols-2'
                      : 'grid-cols-3',
                ]}
                style="max-width: 100%"
              >
                {seg.images!.map((url) => (
                  <img
                    src={url}
                    alt=""
                    class="w-full aspect-square object-cover cursor-zoom-in rounded-[2px]"
                    loading="lazy"
                  />
                ))}
              </div>
            ),
          )
        }
      </div>
    )
  }
  {
    hasImages && (
      <dialog
        aria-label="查看图片"
        class="memo-lightbox fixed inset-0 m-auto place-self-center backdrop:bg-background/80 bg-transparent max-w-[90vw] max-h-[90vh] rounded-xl open:flex items-center justify-center"
      >
        <img src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-lg" />
      </dialog>
    )
  }
  {
        externalUrl && (
          <ExternalLinkCard url={externalUrl} title={externalTitle} />
        )
      }
      {
        musicUrl && (
          <MusicCard url={musicUrl} title={musicTitle} artist={musicArtist} artworkUrl={musicArtwork} />
        )
      }
      <div class="flex items-center gap-2 mt-3">
        <span class="text-sm text-foreground/40">{formattedDate}</span>
        {
          tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {tags.map((tag) => (
                <a
                  href={`/memos/tags/${tagSlug(tag)}`}
                  class="rounded-2xl py-px px-2.5 text-sm bg-foreground/5 hover:bg-foreground/10 border-1 border-foreground/10 transition-colors"
                >
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </div>
</article>

<style is:global>
  .memo-content.prose p {
    margin: 0 0 0.5rem 0;
  }
  .memo-content.prose ul,
  .memo-content.prose ol {
    margin: 0 0 0.5rem 0;
    padding-left: 1.25rem;
  }
  .memo-content.prose li {
    margin: 0;
    padding-left: 0.5rem;
  }
  .memo-content.prose img {
    margin: 0;
  }
  .memo-content.prose h1,
  .memo-content.prose h2,
  .memo-content.prose h3,
  .memo-content.prose h4,
  .memo-content.prose h5,
  .memo-content.prose h6 {
    margin: 0.5rem 0 0.125rem;
  }
  .memo-content.prose > *:first-child {
    margin-top: 0;
  }
  .memo-content.prose > *:last-child {
    margin-bottom: 0;
  }
  .memo-lightbox::backdrop {
    cursor: zoom-out;
  }
</style>

<script>
  document.querySelectorAll('.memo-gallery img').forEach((img) => {
    img.addEventListener('click', () => {
      const card = img.closest('.memo-card')
      const dialog = card?.querySelector('.memo-lightbox') as HTMLDialogElement
      const dialogImg = dialog?.querySelector('img') as HTMLImageElement
      if (dialogImg) {
        dialogImg.src = (img as HTMLImageElement).src
        dialogImg.alt = (img as HTMLImageElement).alt
        dialog?.showModal()
      }
    })
  })
  document.querySelectorAll('.memo-lightbox').forEach((dialog) => {
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) (dialog as HTMLDialogElement).close()
    })
  })
</script>
