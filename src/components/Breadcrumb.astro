---
interface BreadcrumbItem {
  name: string
  url: string
  current?: boolean
}

interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props

// Generate BreadcrumbList structured data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
}
---

<nav aria-label="Breadcrumb" class="text-sm text-muted-foreground mb-4">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, index) => (
        <li class="flex items-center">
          {index > 0 && <span class="mx-2 text-accent/50">/</span>}
          {item.current ? (
            <span class="text-foreground font-medium" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-accent transition-colors">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
