---
interface Props {
  url: string
  title?: string
  artist?: string
  artworkUrl?: string
}

const { url, title, artist, artworkUrl } = Astro.props

function detectPlatform(u: string): { name: string } {
  if (u.includes('music.163.com')) return { name: '网易云音乐' }
  if (u.includes('y.qq.com')) return { name: 'QQ 音乐' }
  if (u.includes('bilibili.com') || u.includes('b23.tv'))
    return { name: 'Bilibili' }
  if (u.includes('music.apple.com')) return { name: 'Apple Music' }
  return { name: new URL(u).hostname }
}

const platform = detectPlatform(url)
const displayTitle = title || '未知歌曲'
const displayArtist = artist ? ` — ${artist}` : ''
---

<a
  href={url}
  target="_blank"
  rel="noreferrer noopener"
  class="block border-b-1 border-accent/10 px-4 py-3 my-4 bg-foreground/5 transition-colors hover:bg-foreground/10"
>
  <div class="flex items-center gap-3">
    {
      artworkUrl
        ? <img src={artworkUrl} alt="" class="music-card-img size-8 object-cover shrink-0" loading="lazy" />
        : (
          <svg class="size-5 shrink-0 text-foreground/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18V5l12-2v13" />
            <circle cx="6" cy="18" r="3" />
            <circle cx="18" cy="16" r="3" />
          </svg>
        )
    }
    <div class="min-w-0">
      <div class="text-sm truncate">{displayTitle}{displayArtist}</div>
      <div class="text-xs text-foreground/50 mt-0.5">{platform.name}</div>
    </div>
  </div>
</a>

<style is:global>
  article .music-card-img {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    display: block !important;
    max-width: none !important;
  }
</style>

