---
interface Props {
  url: string
  title?: string
  artist?: string
}

const { url, title, artist } = Astro.props

function detectPlatform(u: string): { name: string; icon: string } {
  if (u.includes('music.163.com')) return { name: '网易云音乐', icon: '🎵' }
  if (u.includes('y.qq.com')) return { name: 'QQ 音乐', icon: '🎵' }
  if (u.includes('bilibili.com') || u.includes('b23.tv'))
    return { name: 'Bilibili', icon: '🎬' }
  if (u.includes('music.apple.com')) return { name: 'Apple Music', icon: '🎵' }
  return { name: new URL(u).hostname, icon: '🔗' }
}

const platform = detectPlatform(url)
const displayTitle = title || '未知歌曲'
const displayArtist = artist ? ` — ${artist}` : ''
---

<a
  href={url}
  target="_blank"
  rel="noreferrer noopener"
  class="block border-1 border-accent/10 hover:border-accent/30 rounded-xl px-4 py-3 my-4 bg-foreground/5 transition-colors"
>
  <div class="flex items-center gap-3">
    <span class="text-lg shrink-0">{platform.icon}</span>
    <div class="min-w-0">
      <div class="text-sm truncate">{displayTitle}{displayArtist}</div>
      <div class="text-xs text-foreground/50 mt-0.5">{platform.name}</div>
    </div>
  </div>
</a>
