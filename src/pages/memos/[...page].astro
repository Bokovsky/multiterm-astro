---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import MemoPreview from '~/components/MemoPreview.astro'
import Pagination from '~/components/Pagination.astro'
import { getSortedMemos } from '~/utils'
import type { CollectionEntry } from 'astro:content'

export const getStaticPaths = (async ({ paginate }) => {
  const sortedMemos = await getSortedMemos()
  return paginate(sortedMemos, { pageSize: 8 })
}) satisfies GetStaticPaths

const { page } = Astro.props
const allMemos = await getSortedMemos()
const allTags = [...new Set(allMemos.flatMap((m) => m.data.tags || []))].sort()
const memos = page.data as CollectionEntry<'memos'>[]
const pageTitle = page.currentPage > 1 ? `Memos - Page ${page.currentPage}` : 'Memos'
---

<Layout
  title={pageTitle}
  description="Short thoughts, quick notes and ideas"
  tags={allTags}
>
  <div class="mt-2 sm:mt-0 divide-y divide-foreground/[0.06]">
    {memos.map((memo) => <MemoPreview memo={memo} />)}
    <Pagination
      prevLink={page.url.prev ? page.url.prev : undefined}
      prevText="Newer Memos"
      nextLink={page.url.next ? page.url.next : undefined}
      nextText="Older Memos"
    />
  </div>
</Layout>
